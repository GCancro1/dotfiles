[user]
	email = george.cancro@yahoo.com
	name = GCancro1
[push]
	autoSetupRemote = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
	mouse = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
